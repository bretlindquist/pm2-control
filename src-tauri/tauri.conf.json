{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PM2 Control",
  "version": "0.1.2",
  "identifier": "ai.openclaw.pm2control",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "PM2 Control",
        "width": 1080,
        "height": 760,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app"]
  }
}
